rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // =========================================================================
    // STORAGE RULES SIGAR PRO — ISOLAMENTO MULTI-INSTITUCIONAL & DEFAULT-DENY
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() &&
        ('email_verified' in request.auth.token) &&
        request.auth.token.email_verified == true;
    }

    // SUPER_ADMIN exclusivo: moztechwavenacala8@gmail.com com e-mail verificado
    function isSuperAdmin() {
      return isVerifiedEmail() &&
        ('email' in request.auth.token) &&
        request.auth.token.email == 'moztechwavenacala8@gmail.com';
    }

    function hasUserProfileDoc() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function userProfileDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function belongsToInstitution(instId) {
      return isSignedIn() &&
        instId is string &&
        instId.size() > 0 && (
          (('institutionId' in request.auth.token) && request.auth.token.institutionId == instId) ||
          (hasUserProfileDoc() && ('institutionId' in userProfileDoc()) && userProfileDoc().institutionId == instId)
        );
    }

    function hasInstitutionRole(instId, allowedRoles) {
      return isSuperAdmin() || (
        belongsToInstitution(instId) && (
          (('role' in request.auth.token) && request.auth.token.role in allowedRoles) ||
          (hasUserProfileDoc() && ('role' in userProfileDoc()) && userProfileDoc().role in allowedRoles)
        )
      );
    }

    function isInstSecretaria(instId) {
      return hasInstitutionRole(instId, [
        'ADMIN_INSTITUICAO', 'DIRETOR', 'director', 'CEO', 'SECRETARIA', 'secretaria'
      ]);
    }

    function isInstFinanceiro(instId) {
      return hasInstitutionRole(instId, [
        'ADMIN_INSTITUICAO', 'DIRETOR', 'director', 'CEO', 'FINANCEIRO', 'financeiro'
      ]);
    }

    function isInstStaff(instId) {
      return hasInstitutionRole(instId, [
        'ADMIN_INSTITUICAO', 'DIRETOR', 'director', 'CEO',
        'SECRETARIA', 'secretaria',
        'FINANCEIRO', 'financeiro',
        'PROFESSOR', 'FORMADOR', 'professor', 'formador',
        'PORTEIRO', 'porteiro'
      ]);
    }

    function isValidCvUpload(fileName) {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 450 * 1024 &&
        fileName.matches('.*\\.(pdf|doc|docx|PDF|DOC|DOCX)$') &&
        (
          request.resource.contentType == 'application/pdf' ||
          request.resource.contentType == 'application/msword' ||
          request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        );
    }

    // Currículos e anexos de candidaturas de emprego (privado à secretaria/direcção da instituição)
    match /institutions/{instId}/jobApplications/{applicationId}/{fileName} {
      allow read: if isSuperAdmin() || isInstSecretaria(instId);
      allow write: if (isSuperAdmin() || isInstSecretaria(instId)) && isValidCvUpload(fileName);
    }

    // Fotografias de perfil de estudantes (isoladas por instituição)
    match /institutions/{instId}/students/{studentId}/photos/{fileName} {
      allow read: if isSuperAdmin() || isInstStaff(instId);
      allow write: if (isSuperAdmin() || isInstSecretaria(instId)) &&
        request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 2 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Certificados & Diplomas Oficiais SIVEC (verificáveis publicamente por URL/QR, escrita restrita)
    match /institutions/{instId}/certificates/{certId}/{fileName} {
      allow read: if true;
      allow write: if (isSuperAdmin() || isInstSecretaria(instId)) &&
        request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType == 'application/pdf';
    }

    // Faturas e Recibos Financeiros (estritamente restrito ao Financeiro/Direcção da instituição)
    match /institutions/{instId}/finance/{receiptId}/{fileName} {
      allow read: if isSuperAdmin() || isInstFinanceiro(instId);
      allow write: if (isSuperAdmin() || isInstFinanceiro(instId)) &&
        request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 5 * 1024 * 1024 &&
        (
          request.resource.contentType == 'application/pdf' ||
          request.resource.contentType.matches('image/(jpeg|png|webp)')
        );
    }

    // Default-Deny estrito para todos os demais caminhos
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

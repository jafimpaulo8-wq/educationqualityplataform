const VALID_PUBLIC_SLUG_RE = /^[a-z0-9][a-z0-9_-]{0,127}$/;

export type PublicInstitutionSyncStatus = 'success' | 'skipped_no_auth' | 'error';

export interface PublicInstitutionSyncResult {
  status: PublicInstitutionSyncStatus;
